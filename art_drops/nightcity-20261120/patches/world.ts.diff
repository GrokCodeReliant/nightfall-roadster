+  function placeKitRoad(ch: Chunk, index: number, sim: Sim, ox: number, oz: number) {
+    clearKitRoad(ch);
+    ch.kitRoad.visible = false;
+    if (!roadKitReady()) return;
+    const mid = sampleAt(sim.track, index * SEG + Math.floor(SEG / 2));
+    const yw = Math.atan2(mid.tx, mid.tz);
+    const put = (name: string) => {
+      const src = getPiece(name);
+      if (!src) return;
+      const root = src.clone(true);
+      root.traverse((o) => {
+        const m = o as THREE.Mesh;
+        if (!m.isMesh) return;
+        const mat = m.material as THREE.MeshStandardMaterial;
+        if (mat && !mat.userData.rough) roughHook(mat);
+      });
+      root.position.set(mid.x, mid.y, mid.z);
+      root.rotation.set(0, yw, 0);
+      ch.kitRoad.add(root);
+    };
+    put("road_straight_40");
+    put("lanepaint_straight_40");
+    ch.kitRoad.visible = true;
