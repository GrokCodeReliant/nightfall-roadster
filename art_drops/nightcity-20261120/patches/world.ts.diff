+  // --- helpers (place next to buildChunk) ---
+  function clearKitRoad(ch: Chunk) {
+    for (const c of [...ch.kitRoad.children]) {
+      ch.kitRoad.remove(c);
+      // geometries come from the shared kit lib — do not dispose them
+    }
